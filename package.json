{
  "name": "pegscrape",
  "productName": "Pegscrape",
  "version": "0.3.0",
  "description": "Ride log viewer for the ESP32 motorcycle lean-angle logger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types scripts/check-ride.ts",
    "segments": "node --experimental-strip-types --no-warnings scripts/segments.ts",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --no-bundle && node scripts/collect-release.mjs windows",
    "app:installer": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64 && node scripts/collect-release.mjs android",
    "release": "node scripts/collect-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
