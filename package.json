{
  "name": "pegscrape",
  "productName": "Pegscrape",
  "version": "0.3.0",
  "description": "Ride log viewer for the ESP32 motorcycle lean-angle logger",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types scripts/check-ride.ts",
    "segments": "node --experimental-strip-types --no-warnings scripts/segments.ts",
    "electron": "vite build && electron .",
    "electron:dev": "node scripts/electron-dev.mjs",
    "dist:win": "vite build && electron-builder --win",
    "android:init": "vite build && cap add android",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:run": "vite build && cap sync android && cap run android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.incli.app",
    "productName": "Pegscrape",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
