{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pegscrape",
  "version": "0.3.0",
  "identifier": "com.incli.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pegscrape",
        "width": 1400,
        "height": 900,
        "minWidth": 420,
        "minHeight": 600,
        "backgroundColor": "#0a0a0a",
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 4,
      "minSdkVersion": 26
    }
  }
}
